{
  "name": "roman-catholic-church-calendar",
  "version": "0.1.0",
  "description": "Roman Catholic liturgical calendar (General Roman Calendar, US and Czech propers) as a zero-dependency TypeScript library and drop-in replacement for the Ruby church-calendar-api v0 JSON API.",
  "keywords": [
    "catholic",
    "roman-catholic",
    "liturgy",
    "liturgical-calendar",
    "liturgical-year",
    "general-roman-calendar",
    "calendarium-romanum",
    "church-calendar-api"
  ],
  "license": "LGPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "default": "./dist/api/index.js"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "default": "./dist/http/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "core": [
        "./dist/core/index.d.ts"
      ],
      "api": [
        "./dist/api/index.d.ts"
      ],
      "http": [
        "./dist/http/index.d.ts"
      ]
    }
  },
  "sideEffects": false,
  "bin": {
    "roman-catholic-church-calendar": "bin/server.mjs"
  },
  "files": [
    "dist",
    "bin",
    "lambda",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "COPYING",
    "THIRD-PARTY-NOTICES.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "sync-data": "node scripts/sync-data.mjs",
    "capture-baseline": "node scripts/capture-baseline.mjs",
    "start": "node bin/server.mjs",
    "preversion": "npm run typecheck && npm test",
    "version": "npm run changelog && git add CHANGELOG.md",
    "postversion": "git push && git push --tags",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -r 0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lumen-de-Lumine/church-calendar.git"
  },
  "homepage": "https://github.com/Lumen-de-Lumine/church-calendar#readme",
  "bugs": {
    "url": "https://github.com/Lumen-de-Lumine/church-calendar/issues"
  },
  "devDependencies": {
    "@swc/core": "^1.13.0",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "conventional-changelog": "^8.1.3",
    "conventional-changelog-angular": "^9.4.0",
    "jest": "^30.5.0",
    "js-yaml": "^4.1.0",
    "typescript": "^5.9.3"
  }
}
